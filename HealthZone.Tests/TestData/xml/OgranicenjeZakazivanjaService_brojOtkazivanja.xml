  <scenarij><otkazivanje pomakDana="-3" /><otkazivanje pomakDana="-12" /><otkazivanje pomakDana="-20" /><mozeZakazati>false</mozeZakazati></scenarij>
  <scenarij><otkazivanje pomakDana="-1" /><otkazivanje pomakDana="-2" /><otkazivanje pomakDana="-3" /><otkazivanje pomakDana="-4" /><otkazivanje pomakDana="-5" /><mozeZakazati>false</mozeZakazati></scenarij>
</scenariji>
